# Copy to .env for local development. Never commit real values.

# --- apps/api ---
API_HOST=127.0.0.1
API_PORT=4000
LOG_LEVEL=info

# --- apps/web ---
# Base URL the web app uses to reach the API (server-side).
LEKVERO_API_BASE_URL=http://127.0.0.1:4000

