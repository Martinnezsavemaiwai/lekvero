# Copy to .env for local development. Never commit real values.
# All passwords below are LOCAL-ONLY placeholders: replace them.

LEKVERO_ENV=local

# --- apps/api ---
API_HOST=127.0.0.1
API_PORT=4000
LOG_LEVEL=info

# --- apps/web ---
LEKVERO_API_BASE_URL=http://127.0.0.1:4000

# --- database (M3) ---
# docker-compose superuser (local only)
POSTGRES_PASSWORD=change-me-local-only
# Admin connection: used by `pnpm db:bootstrap-roles` and as DATABASE_URL for `pnpm test:db`.
ADMIN_DATABASE_URL=postgres://postgres:change-me-local-only@127.0.0.1:5432/postgres
DATABASE_URL=postgres://postgres:change-me-local-only@127.0.0.1:5432/postgres
# Created by db:bootstrap-roles (passwords ≥16 chars):
LEKVERO_DB_NAME=lekvero
LEKVERO_MIGRATOR_DB_PASSWORD=change-me-migrator-local
LEKVERO_INGEST_DB_PASSWORD=change-me-ingest-local
LEKVERO_API_DB_PASSWORD=change-me-api-local-only
# Role-specific runtime URLs:
MIGRATION_DATABASE_URL=postgres://lekvero_migrator:change-me-migrator-local@127.0.0.1:5432/lekvero
INGEST_DATABASE_URL=postgres://lekvero_ingest:change-me-ingest-local@127.0.0.1:5432/lekvero
API_DATABASE_URL=postgres://lekvero_api:change-me-api-local-only@127.0.0.1:5432/lekvero

# --- future milestones (not used yet) ---
# GLO_API_BASE_URL=https://www.glo.or.th/api   # M4 (live ingestion; NOT enabled)
